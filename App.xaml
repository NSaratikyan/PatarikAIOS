<Application x:Class="PatarikAIOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0F766E" />
    <SolidColorBrush x:Key="Warning" Color="#B45309" />
    <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,4,0,4" /><Setter Property="Padding" Value="12,8" /><Setter Property="Cursor" Value="Hand" /></Style>
  </Application.Resources>
</Application>
