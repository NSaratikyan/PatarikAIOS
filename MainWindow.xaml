<Window x:Class="PatarikAIOS.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Patarik AI OS" Width="1600" Height="980" MinWidth="1000" MinHeight="680" Background="#F4F7FC" UseLayoutRounding="True">
 <Grid Background="#F4F7FC">
  <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#10213D" Padding="14,24,14,18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,30">
     <Border Background="#0962FF" CornerRadius="12" Width="40" Height="43"><TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="Patarik AI OS" Foreground="#F1F5FF" FontWeight="Bold" FontSize="23" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,10,8,0">
     <Separator Background="#2A3B56" Margin="0,8,0,12"/>
     <Expander Header="⚙  Կարգավորումներ" Foreground="#C3D3EB">
      <StackPanel>
       <Button x:Name="ApiButton" Content="ՀԾ API" Click="ConfigureHtsApi_Click"/>
       <Button x:Name="TelegramButton" Content="Telegram" Click="ConfigureTelegram_Click"/>
       <Button x:Name="EmployeeTelegramButton" Content="Աշխատակիցների բոտ" Click="ConfigureEmployeeTelegram_Click"/>
       <Button x:Name="CashAdjustmentButton" Content="Դրամարկղ / բանկ․ մնացորդ" Click="AddCashDeskAdjustment_Click"/>
       <Button Content="Մատակարարի պարտք" Click="EditSupplierDebt_Click"/>
      </StackPanel>
     </Expander>
     <TextBlock x:Name="DataSourceStatusText" Text="Տվյալների աղբյուր" Foreground="#95ABC9" FontSize="11" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,14,0,0"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="NavigationPanel">
      <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"/></StackPanel.Resources>
      <Button Content="⌂   Օրվա ամփոփում" Tag="Dashboard" Click="Navigate_Click"/>
      <Button Content="▤   Պատվերներ" Tag="Suppliers" Click="Navigate_Click"/>
      <Button Content="▣   Վաղվա պատվերներ" Tag="PurchasePlan" Click="Navigate_Click"/>
      <Button Content="✓   Հաստատումներ" Tag="Approvals" Click="Navigate_Click"/>
      <Button Content="▥   Մատակարարների վերլուծություն" Tag="SupplierSales" Click="Navigate_Click"/>
      <Button Content="֏   Ֆինանսներ" Tag="Finance" Click="Navigate_Click"/>
      <Button Content="↗   Դրամական շարժ" Tag="CashMovements" Click="Navigate_Click"/>
      <Button Content="☷   Վճարումների պլան" Tag="Payments" Click="Navigate_Click"/>
      <Button Content="♙   Աշխատավարձեր" Tag="Salaries" Click="Navigate_Click"/>
      <Button Content="▦   Excel ներմուծում" Click="OpenExcelImports_Click"/>
      <Button Content="▥   Ժամանակահատվածի ամփոփում" Tag="Summary" Click="Navigate_Click"/>
      <Button Content="✧   Առաջարկներ / առաջադրանքներ" Tag="Recommendations" Click="Navigate_Click"/>
      <Button x:Name="CashImportButton" Content="Ներմուծել դրամարկղային ֆայլ" Click="ImportCashDocument_Click"/>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,22,24,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock x:Name="PageTitleText" Text="Օրվա ամփոփում" FontSize="30" FontWeight="Bold" Foreground="#10213D" TextWrapping="Wrap"/><TextBlock x:Name="SubtitleText" Foreground="#72839C" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
     <TextBlock x:Name="DateLabel" Text="Օր" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <DatePicker x:Name="ViewDatePicker" Width="148" SelectedDateChanged="ViewDatePicker_SelectedDateChanged" Margin="0,4,8,4"/>
     <Button x:Name="ShowDateButton" Content="Ցույց տալ" Click="ShowSelectedDate_Click" Margin="0,4,8,4"/>
     <Button x:Name="RefreshButton" Content="↻" ToolTip="Թարմացնել տվյալները" Click="Refresh_Click" Width="42" Padding="8"/>
    </StackPanel>
   </Grid>
   <WrapPanel Grid.Row="1" Margin="0,0,0,12">
    <StackPanel x:Name="OrderPeriodPanel" Orientation="Horizontal" Margin="0,0,16,6">
     <Button x:Name="CurrentOrderTab" Content="Ընտրված օր" Tag="Suppliers" Click="Navigate_Click" Margin="0,0,4,0"/>
     <Button x:Name="NextOrderTab" Content="Հաջորդ օրը" Tag="PurchasePlan" Click="Navigate_Click" Margin="0"/>
    </StackPanel>
    <Button x:Name="CompletedPaymentButton" Content="✓ Կատարված վճարում" Click="AddCompletedPayment_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
    <Button x:Name="FundsTransactionButton" Content="＋ Շարժ գրանցել" Click="AddFundsTransaction_Click" Margin="0,0,8,6"/>
    <Button x:Name="CashFlowPolicyButton" Content="⚙ Ֆինանսական կանոններ" Click="ConfigureCashFlowPolicy_Click" Margin="0,0,8,6"/>
    <Button x:Name="RequiredPaymentButton" Content="＋ Պարտադիր վճարում" Click="AddRequiredPayment_Click" Margin="0,0,8,6"/>
    <Button x:Name="SupplierDayButton" Content="↔ Փոխել մատակարարի օրը" Click="ChangeSupplierWeekDay_Click" Margin="0,0,8,6"/>
    <Button x:Name="SupplierMembershipButton" Content="＋ / − Մատակարար" ToolTip="Կարգավորել մատակարարի մասնակցությունը" Click="EditSupplierScheduleMembership_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
    <Button x:Name="PaymentChangeButton" Content="＋ Վճարման փոփոխություն" Click="AddPaymentChange_Click" Margin="0,0,8,6"/>
   </WrapPanel>
   <ContentControl x:Name="PageHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
 </Grid>
</Window>
