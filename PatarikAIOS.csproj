<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="approved-supplier-names.json" />
    <!-- The Automation Host is a separate executable and must not be compiled
         into the WPF desktop application. -->
    <Compile Remove="Automation\**\*.cs" />
  </ItemGroup>
</Project>
